    "next-sanity": "^0.8.5",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-spring-bottom-sheet": "^3.4.1",
    "swr": "^1.3.0"
  },
  "devDependencies": {
    "@sanity/cli": "^2.36.2",
    "@types/node": "^17.0.45",
    "autoprefixer": "^10.5.5",
    "lerna": "^4.0.0",
    "postcss": "^8.5.28",
